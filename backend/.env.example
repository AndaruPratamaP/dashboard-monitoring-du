# ==============================================================================
# PUVA EVAL-CORE ENVIRONMENT VARIABLES
# ==============================================================================

# 1. Google Gemini AI API Key (Untuk AI Evidence Checker Rekonsiliasi)
# Dapatkan API Key gratis di: https://aistudio.google.com/app/apikey
# Catatan: Jika dikosongkan, sistem otomatis menggunakan Fallback Deterministic Rule Analyzer PADG 23/2024
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Database Connection URL (Opsional)
# - Untuk Lokal (Default): Biarkan kosong atau tidak didefinisikan (otomatis menggunakan SQLite puva_eval.db)
# - Untuk Cloud (Supabase / Render PostgreSQL):
#   Format: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# DATABASE_URL=postgresql://postgres.xxx:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# 3. Environment Mode (development / production)
ENVIRONMENT=development
